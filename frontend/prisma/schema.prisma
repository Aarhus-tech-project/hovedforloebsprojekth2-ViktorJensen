// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model UserData {
  userID     String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  username   String   @unique
  pwdHash    String

  portfolios PortfolioData[]
  buyTrades  Trade[]  @relation("BuyerTrades")
  sellTrades Trade[]  @relation("SellerTrades")

}

model PortfolioData {
  portfolioID String   @id @default(uuid()) @db.Uuid
  userID      String   @db.Uuid
  cashBalance Decimal

  user     UserData     @relation(fields: [userID], references: [userID])
  holdings Holdings[]

  @@index([userID])
}

model Stock {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique

  data    StockData[]
  trades  Trade[]
  holdings   Holdings[]
}

model StockData {
  id         String   @id @default(uuid()) @db.Uuid
  stockId    String   @db.Uuid
  stock      Stock    @relation(fields: [stockId], references: [id])
  open       Float
  close      Float
  volume     BigInt

  fetchedAt  DateTime

  @@index([stockId, fetchedAt])
  @@unique([stockId, fetchedAt])
}

model Trade {
  tradeID     String   @id @default(uuid()) @db.Uuid
  buyerID     String   @db.Uuid
  sellerID    String   @db.Uuid
  stockID     String   @db.Uuid

  stock       Stock    @relation(fields: [stockID], references: [id])

  price       Decimal
  shareAmount Int
  timestamp   DateTime

  buyer  UserData @relation("BuyerTrades", fields: [buyerID], references: [userID])
  seller UserData @relation("SellerTrades", fields: [sellerID], references: [userID])

  holdings Holdings[]

}

model Holdings {
  portfolioID  String        @db.Uuid
  stockID      String        @db.Uuid
  tradeID      String        @db.Uuid

  portfolio PortfolioData @relation(fields: [portfolioID], references: [portfolioID])
  stock     Stock         @relation(fields: [stockID], references: [id])
  trade     Trade         @relation(fields: [tradeID], references: [tradeID])

  @@id([portfolioID, stockID, tradeID])
}